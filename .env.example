# --- Veritabanı ---
DATABASE_URL="postgresql://kampus:kampus@localhost:5432/kampus?schema=public"

# --- API ---
# 3000/4000 sık kullanıldığı için varsayılanlar 3100/4100 seçildi.
PORT=4100
NODE_ENV=development
API_PUBLIC_URL="http://localhost:4100"
WEB_PUBLIC_URL="http://localhost:3100"

# openssl rand -base64 48  ile üretin (production'da MUTLAKA değiştirin)
JWT_ACCESS_SECRET="dev-access-secret-degistirin-lutfen-32-karakterden-uzun"
JWT_REFRESH_SECRET="dev-refresh-secret-degistirin-lutfen-32-karakterden-uzun"
ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_TTL_DAYS=30

# --- E-posta (geliştirmede Mailpit) ---
SMTP_HOST="localhost"
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="Kampus <noreply@kampus.app>"

# --- Kayıt kuralları ---
# strict  = sadece packages/shared içindeki onaylı üniversite listesi
# edu     = *.edu.tr / *.edu uzantılı her alan adı
ALLOWED_DOMAIN_MODE="strict"
# İlk yönetici hesabının kullanıcı adı (ör. mbk25). Boş bırakılırsa atanmaz.
INITIAL_ADMIN_USERNAME=""

# --- Web ---
NEXT_PUBLIC_API_URL="http://localhost:4100"

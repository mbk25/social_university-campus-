# ============================================================================
# PRODUCTION ORTAM DEĞİŞKENLERİ
#
# Bu dosyayı sunucuya kopyalamayın — değerleri ilgili panellere yapıştırın:
#   API  -> Railway / Render  > Variables
#   Web  -> Vercel            > Settings > Environment Variables
# ============================================================================


# ─────────────────────────────────────────────── API  (Railway / Render)

NODE_ENV=production
PORT=4100

# Railway'de veritabanı aynı projedeyse referansla bağlayın (önerilen):
#   DATABASE_URL=${{Postgres.DATABASE_URL}}
# Harici bir veritabanı (Neon, Supabase) kullanıyorsanız tam adresi yazın.
# Neon'da "Connection pooling" KAPALI adresi alın — migration'lar takılmasın.
DATABASE_URL="postgresql://KULLANICI:SIFRE@HOST/VERITABANI?sslmode=require"

# Bu iki değeri MUTLAKA yeniden üretin (her biri ayrı olmalı):
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_ACCESS_SECRET="BURAYA_URETILEN_DEGER"
JWT_REFRESH_SECRET="BURAYA_FARKLI_BIR_DEGER"
ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_TTL_DAYS=30

# Gerçek adresler — CORS ve e-posta bağlantıları bunlara göre kurulur.
# WEB_PUBLIC_URL yanlışsa tarayıcı istekleri CORS'a takılır.
API_PUBLIC_URL="https://api.kampus.app"
WEB_PUBLIC_URL="https://kampus.app"
# Vercel önizleme dağıtımları için ek kaynaklar (virgülle ayırın)
EXTRA_CORS_ORIGINS="https://kampus.vercel.app"

# --- E-posta (Resend SMTP) -------------------------------------------------
# resend.com > API Keys > yeni anahtar. Kullanıcı adı harfi harfine "resend".
SMTP_HOST="smtp.resend.com"
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER="resend"
SMTP_PASS="re_XXXXXXXXXXXX"
# Gönderen alan adı Resend'de doğrulanmış olmalı.
MAIL_FROM="Kampus <noreply@kampus.app>"

# --- Dosya depolama (Cloudflare R2) ---------------------------------------
# Boş bırakılırsa dosyalar sunucu diskine yazılır ve her dağıtımda SİLİNİR.
S3_BUCKET="kampus-uploads"
S3_REGION="auto"
S3_ENDPOINT="https://HESAP_ID.r2.cloudflarestorage.com"
S3_ACCESS_KEY_ID="..."
S3_SECRET_ACCESS_KEY="..."
# Bucket'ın herkese açık adresi (R2 > Settings > Public access)
S3_PUBLIC_URL="https://cdn.kampus.app"

MAX_UPLOAD_MB=25

# strict = yalnızca onaylı üniversite listesi | edu = *.edu.tr / *.edu serbest
ALLOWED_DOMAIN_MODE="strict"

# İlk yönetici hesabının kullanıcı adı (ör. mbk25). İlk girişte kalıcı ADMIN olur.
INITIAL_ADMIN_USERNAME=""


# ─────────────────────────────────────────────────────────── WEB  (Vercel)

NEXT_PUBLIC_API_URL="https://api.kampus.app"
